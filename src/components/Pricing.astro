---
import { units, statusLabel, site } from '../data/site';
---

<section id="cennik" class="scroll-mt-20 border-t border-line/60 bg-ink-soft/50 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-3xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-accent">Cennik</p>
      <h2 class="font-display text-3xl font-bold tracking-tight text-sand sm:text-5xl text-balance">
        Ceny i historia zmian
      </h2>
      <p class="mt-4 text-muted">
        Zgodnie z art. 19a ustawy deweloperskiej publikujemy ceny brutto (z VAT) za m² i całkowite,
        ceny pomieszczeń przynależnych oraz historię zmian cen od dnia rozpoczęcia sprzedaży.
      </p>
    </div>

    <!-- Slot: publikatorcen.pl embed -->
    <div
      id="publikatorcen-embed"
      class="reveal mt-10 rounded-xl border border-dashed border-accent/50 bg-ink/70 p-6 sm:p-8"
      data-embed-ready="false"
    >
      <p class="font-display text-xl font-bold text-sand">Publikator Cen — miejsce na embed</p>
      <p class="mt-2 max-w-2xl text-sm text-muted">
        Tutaj pojawi się widżet / iframe z <strong class="text-sand">publikatorcen.pl</strong> dla
        inwestycji Osiedle Ziętka (karty lokali, cena/m², cena całkowita, przynależności, historia).
        Po otrzymaniu kodu osadzenia wystarczy wkleić go w ten kontener.
      </p>
    </div>

    <!-- Mobile: cards -->
    <div class="reveal mt-8 space-y-3 md:hidden" aria-label="Lista segmentów Osiedle Ziętka">
      {
        units.map((unit) => (
          <article class="rounded-xl border border-line bg-ink/70 p-4">
            <div class="flex items-baseline justify-between gap-3">
              <h3 class="font-display text-xl font-bold text-sand">Segment {unit.id}</h3>
              <p class="text-base font-semibold text-accent">{statusLabel[unit.status]}</p>
            </div>
            <dl class="mt-4 space-y-3 text-base">
              <div class="flex justify-between gap-4 border-t border-line/60 pt-3">
                <dt class="text-muted">Pow. użytkowa</dt>
                <dd class="text-right font-medium text-sand">{unit.area} m²</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-line/60 pt-3">
                <dt class="text-muted">Cena brutto / m²</dt>
                <dd class="text-right font-medium text-sand">— (Publikator Cen)</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-line/60 pt-3">
                <dt class="text-muted">Cena całkowita brutto</dt>
                <dd class="text-right font-medium text-sand">— (Publikator Cen)</dd>
              </div>
              <div class="flex justify-between gap-4 border-t border-line/60 pt-3">
                <dt class="text-muted">Przynależności</dt>
                <dd class="text-right font-medium text-sand">— (Publikator Cen)</dd>
              </div>
            </dl>
          </article>
        ))
      }
    </div>

    <!-- Desktop: table -->
    <div class="reveal mt-8 hidden overflow-x-auto rounded-xl border border-line md:block">
      <table class="min-w-full text-left text-sm">
        <caption class="sr-only">
          Wstępna lista segmentów Osiedle Ziętka — ceny zostaną uzupełnione z publikatorcen.pl
        </caption>
        <thead class="bg-surface text-xs uppercase tracking-wide text-muted">
          <tr>
            <th class="px-4 py-3 font-semibold">Segment</th>
            <th class="px-4 py-3 font-semibold">Pow. użytkowa</th>
            <th class="px-4 py-3 font-semibold">Status</th>
            <th class="px-4 py-3 font-semibold">Cena brutto / m²</th>
            <th class="px-4 py-3 font-semibold">Cena całkowita brutto</th>
            <th class="px-4 py-3 font-semibold">Przynależności</th>
          </tr>
        </thead>
        <tbody>
          {
            units.map((unit) => (
              <tr class="border-t border-line/80">
                <td class="px-4 py-3 font-semibold text-sand">{unit.id}</td>
                <td class="px-4 py-3 text-muted">{unit.area} m²</td>
                <td class="px-4 py-3 text-muted">{statusLabel[unit.status]}</td>
                <td class="px-4 py-3 text-muted">— (Publikator Cen)</td>
                <td class="px-4 py-3 text-muted">— (Publikator Cen)</td>
                <td class="px-4 py-3 text-muted">— (Publikator Cen)</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>

    <p class="reveal mt-4 text-xs leading-relaxed text-muted">
      Ceny brutto (z VAT). Historia zmian od dnia rozpoczęcia sprzedaży zgodnie z art. 19a ust. 2
      ustawy o ochronie praw nabywcy lokalu mieszkalnego lub domu jednorodzinnego oraz Deweloperskim
      Funduszu Gwarancyjnym. Tabela powyżej jest szkieletem zgodności — źródłem cen będzie
      publikatorcen.pl. Statusy segmentów mogą ulec zmianie.
    </p>
    <p class="mt-2 text-xs text-muted">
      Inwestycja: {site.name}, {site.address}.
    </p>
  </div>
</section>
