---
import { site } from '../data/site';
const d = site.developer;
const inv = site.investment;
---

<section id="deweloper" class="scroll-mt-20 border-t border-line/60 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal max-w-2xl">
      <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-accent">Deweloper</p>
      <h2 class="font-display text-3xl font-bold tracking-tight text-sand sm:text-5xl">
        Dane sprzedającego
      </h2>
      <p class="mt-4 text-muted">
        Informacje o deweloperze i przedsięwzięciu zgodnie z art. 19a ustawy deweloperskiej.
      </p>
    </div>

    <dl class="reveal mt-10 grid gap-6 sm:grid-cols-2">
      <div class="border-t border-line pt-4 sm:col-span-2">
        <dt class="text-xs uppercase tracking-wide text-muted">Firma</dt>
        <dd class="mt-2 text-sand">{d.name}</dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">Forma prawna</dt>
        <dd class="mt-2 text-sand">{d.legalForm}</dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">Status</dt>
        <dd class="mt-2 text-sand">Aktywna</dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">NIP</dt>
        <dd class="mt-2 text-sand">{d.nip}</dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">REGON</dt>
        <dd class="mt-2 text-sand">{d.regon}</dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">KRS</dt>
        <dd class="mt-2 text-sand">{d.krs}</dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">Kapitał zakładowy</dt>
        <dd class="mt-2 text-sand">{d.shareCapital}</dd>
      </div>
      <div class="border-t border-line pt-4 sm:col-span-2">
        <dt class="text-xs uppercase tracking-wide text-muted">
          Adres siedziby / miejsca działalności
        </dt>
        <dd class="mt-2 text-sand">{d.seat}</dd>
      </div>
      <div class="border-t border-line pt-4 sm:col-span-2">
        <dt class="text-xs uppercase tracking-wide text-muted">Adres lokalu sprzedaży</dt>
        <dd class="mt-2 text-sand">{d.salesOffice}</dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">Telefon</dt>
        <dd class="mt-2">
          <a class="text-accent hover:text-accent-hot" href={site.phoneHref}>{site.phone}</a>
        </dd>
      </div>
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">E-mail</dt>
        <dd class="mt-2">
          <a class="text-accent hover:text-accent-hot" href={`mailto:${site.email}`}>{site.email}</a>
        </dd>
      </div>
    </dl>

    <h3 class="reveal mt-14 font-display text-2xl font-bold text-sand">Przedsięwzięcie deweloperskie</h3>
    <dl class="reveal mt-6 grid gap-6 sm:grid-cols-2">
      <div class="border-t border-line pt-4">
        <dt class="text-xs uppercase tracking-wide text-muted">Numer księgi wieczystej</dt>
        <dd class="mt-2 text-sand">{inv.landRegister}</dd>
      </div>
      <div class="border-t border-line pt-4 sm:col-span-2">
        <dt class="text-xs uppercase tracking-wide text-muted">
          Miejscowy plan zagospodarowania przestrzennego
        </dt>
        <dd class="mt-2 text-sand">{inv.zoningTitle}</dd>
        <dd class="mt-2 text-muted">{inv.zoningResolution}</dd>
        <dd class="mt-2 text-sand">Oznaczenie terenu w MPZP: {inv.zoningLabel}</dd>
      </div>
      <div class="border-t border-line pt-4 sm:col-span-2">
        <dt class="text-xs uppercase tracking-wide text-muted">Numery działek objętych inwestycją</dt>
        <dd class="mt-2 text-sand">
          {inv.plots.map((p) => `działka nr ${p}`).join(', ')}.
        </dd>
        <dd class="mt-2 text-muted">
          Działki wyodrębnione do księgi wieczystej nr {inv.landRegister}.
        </dd>
      </div>
    </dl>
  </div>
</section>
