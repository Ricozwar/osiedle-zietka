---
import { site, asset } from '../data/site';
---

<div
  id="cookie-banner"
  class="fixed inset-x-0 bottom-0 z-[60] hidden border-t border-line bg-ink-soft/95 p-4 backdrop-blur-md"
  role="dialog"
  aria-label="Zgoda na cookies"
>
  <div class="mx-auto flex max-w-6xl flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-sm text-muted">
      Używamy niezbędnych plików cookies do działania strony. Szczegóły w
      <a href={asset('polityka-prywatnosci/')} class="text-accent hover:underline">polityce prywatności</a>.
    </p>
    <div class="flex gap-2">
      <button
        type="button"
        id="cookie-accept"
        class="rounded-md bg-accent px-4 py-2 text-sm font-semibold text-ink"
      >
        Akceptuję
      </button>
    </div>
  </div>
</div>

<a
  href={site.phoneHref}
  class="fixed bottom-4 right-4 z-50 inline-flex items-center gap-2 rounded-full bg-accent px-4 py-3 text-sm font-bold text-ink shadow-lg shadow-black/40 lg:hidden"
>
  Zadzwoń
</a>

<script>
  const KEY = 'oz-cookies-ok';
  const banner = document.getElementById('cookie-banner');
  const accept = document.getElementById('cookie-accept');
  const settings = document.getElementById('cookie-settings');

  const show = () => banner?.classList.remove('hidden');
  const hide = () => banner?.classList.add('hidden');

  if (!localStorage.getItem(KEY)) show();
  accept?.addEventListener('click', () => {
    localStorage.setItem(KEY, '1');
    hide();
    window.dispatchEvent(new CustomEvent('oz-cookies-accepted'));
  });
  settings?.addEventListener('click', show);
</script>
