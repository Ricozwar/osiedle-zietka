---
import { asset, site } from '../data/site';

const items = [
  {
    title: 'Instalacje',
    text: 'Ogrzewanie podłogowe, indywidualne ogrzewanie gazowe, instalacja elektryczna, wodno-kanalizacyjna oraz centralnego ogrzewania.',
  },
  {
    title: 'Wykończenie stanu deweloperskiego',
    text: 'Tynki wewnętrzne, wylewki, stolarka okienna i drzwiowa oraz elewacja budynków.',
  },
  {
    title: 'Parking i dojazd',
    text: 'Dwa miejsca postojowe dla lokalu oraz droga wewnętrzna wykonana z kostki brukowej.',
  },
  {
    title: 'Teren inwestycji',
    text: 'Zagospodarowanie terenu inwestycji w ramach stanu deweloperskiego.',
  },
];
---

<section id="standard" class="scroll-mt-20 border-t border-line/60 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-accent">Segmenty i standard</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-sand sm:text-5xl text-balance">
          Stan deweloperski — to, co dostajesz wraz z kluczem.
        </h2>
        <p class="mt-4 text-muted">
          Zakres wykończenia zgodnie z prospektem informacyjnym przedsięwzięcia Osiedle Ziętka.
        </p>
      </div>
      <img
        src={asset('images/gallery/08-standard.jpg')}
        alt="Standard wykończenia lokali Osiedle Ziętka"
        class="reveal h-auto w-full rounded-xl border border-line object-contain"
        loading="lazy"
      />
    </div>

    <div class="reveal mt-12 grid gap-8 sm:grid-cols-2">
      {
        items.map((item) => (
          <div class="border-t border-accent/30 pt-5">
            <h3 class="font-display text-xl font-bold text-sand">{item.title}</h3>
            <p class="mt-3 text-muted">{item.text}</p>
          </div>
        ))
      }
    </div>

    <ul class="reveal mt-10 columns-1 gap-x-10 space-y-2 sm:columns-2">
      {
        site.investment.finishStandard.map((item) => (
          <li class="break-inside-avoid flex gap-3 text-sand/90">
            <span class="mt-2 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>{item}</span>
          </li>
        ))
      }
    </ul>
  </div>
</section>
