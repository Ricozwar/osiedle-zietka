---
import { asset, site } from '../data/site';
---

<section id="standard" class="scroll-mt-20 border-t border-line/60 py-20 sm:py-28">
  <div class="mx-auto max-w-6xl px-4 sm:px-6">
    <div class="reveal grid gap-8 lg:grid-cols-[1.1fr_0.9fr] lg:items-end">
      <div class="max-w-2xl">
        <p class="mb-3 text-sm font-semibold uppercase tracking-[0.18em] text-accent">Segmenty i standard</p>
        <h2 class="font-display text-3xl font-bold tracking-tight text-sand sm:text-5xl text-balance">
          Standard wykończenia
        </h2>
        <p class="mt-4 text-muted">
          Podsumowanie załącznika nr 4 do prospektu informacyjnego przedsięwzięcia Osiedle Ziętka.
        </p>
      </div>
      <img
        src={asset('images/gallery/08-standard.jpg')}
        alt="Standard wykończenia lokali Osiedle Ziętka"
        class="reveal h-auto w-full rounded-xl border border-line object-contain"
        loading="lazy"
      />
    </div>

    <ul class="reveal mt-12 space-y-4 border-t border-accent/30 pt-8">
      {
        site.investment.finishStandard.map((item) => (
          <li class="flex gap-3 text-base text-sand/90 sm:text-lg">
            <span class="mt-2.5 h-1.5 w-1.5 shrink-0 rounded-full bg-accent" aria-hidden="true" />
            <span>
              <strong class="font-semibold text-sand">{item.title}:</strong>{' '}
              <span class="text-muted">{item.text}</span>
            </span>
          </li>
        ))
      }
    </ul>

    <p class="reveal mt-10 max-w-3xl border-t border-line pt-6 text-sm leading-relaxed text-muted">
      {site.investment.finishStandardExclusions}
    </p>
  </div>
</section>
